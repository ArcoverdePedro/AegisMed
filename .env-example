# AegisShare - exemplo de configuracao
# Copie para .env e troque todos os valores marcados como CHANGE_ME.

# Aplicacao
DEBUG=false
ENVIRONMENT=production
PORT=8000
APP_PORT=8000
TIME_ZONE=America/Fortaleza
SECRET_KEY=CHANGE_ME_GERE_COM_SCRIPTS_GENERATE_SECRETS
FILE_ENCRYPTION_KEY=CHANGE_ME_GERE_COM_SCRIPTS_GENERATE_SECRETS

# Hosts / HTTPS
ALLOWED_HOSTS=localhost,127.0.0.1,seu-dominio.com.br
CSRF_TRUSTED_ORIGINS=https://seu-dominio.com.br
# IP ou rede (CIDR) do proxy reverso. Use * somente se a porta do app nao for publica.
TRUSTED_PROXY_IPS=127.0.0.1
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# PostgreSQL do compose.yml
POSTGRES_DB=aegisshare
POSTGRES_USER=aegisshare
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Para executar Django fora do Docker, voce tambem pode definir diretamente:
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# REDIS_URL=redis://host:6379/0

# Migrations: false em producao (rode `docker compose run --rm aegis_share python manage.py migrate`
# depois do backup). O container nao inicia se houver migration pendente.
RUN_MIGRATIONS=false

# Chave dos backups (scripts/backup.sh); diferente da FILE_ENCRYPTION_KEY e guardada fora do servidor.
BACKUP_ENCRYPTION_KEY=

# Arquivos
FILE_MAX_UPLOAD_MB=50

# Observabilidade
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Processo web
WEB_WORKERS=2
COLLECT_STATIC=true
DB_STARTUP_ATTEMPTS=30

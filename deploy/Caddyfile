# Exemplo de proxy HTTPS do AegisMed com Caddy instalado no proprio servidor.
# O compose nao sobe proxy: a aplicacao escuta so em 127.0.0.1:8000 (APP_BIND/APP_PORT).
#
# Uso: troque his.exemplo.gov.br pelo seu dominio, copie para /etc/caddy/Caddyfile
# e rode `systemctl reload caddy`.
#
# Dominio publico: o Caddy emite o certificado (Let's Encrypt) sozinho; libere as portas 80/443.
# Nome so da rede do hospital: descomente `tls internal` e instale nas estacoes a CA raiz
# (/var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt).
#
# No .env: TRUSTED_PROXY_IPS=172.16.0.0/12 (o container ve o gateway da rede Docker como origem).

his.exemplo.gov.br {
	# tls internal
	encode zstd gzip
	# Mesmo limite de FILE_MAX_UPLOAD_MB (+ folga do multipart).
	request_body {
		max_size 52MB
	}
	# Repassa X-Forwarded-For/Proto e WebSocket automaticamente.
	reverse_proxy 127.0.0.1:8000
}
